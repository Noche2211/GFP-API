{
    "root": true,
    "env": {
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "indent": [
            "error",
            4
        ],
        "quotes": [
            "error",
            "single",
            {
                "avoidEscape": true
            }
        ],
        "semi": [
            "error",
            "always"
        ],
        "no-var": "error",
        "prefer-const": "warn",
        "no-unused-vars": [
            "warn",
            {
                "args": "none",
                "ignoreRestSiblings": true
            }
        ],
        "no-console": "off"
    },
    "overrides": [
        {
            "files": [
                "backend/**/*.js"
            ],
            "env": {
                "node": true
            }
        },
        {
            "files": [
                "frontend/js/**/*.js"
            ],
            "env": {
                "browser": true
            }
        }
    ]
}
